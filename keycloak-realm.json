{
    "realm": "erp-realm",
    "enabled": true,
    "roles": {
        "realm": [
            {
                "name": "admin",
                "description": "Administrator role"
            },
            {
                "name": "user",
                "description": "Standard user role"
            }
        ],
        "client": {
            "erp-frontend": [
                {
                    "name": "admin"
                },
                {
                    "name": "user"
                }
            ],
